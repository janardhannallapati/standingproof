# Copy to .env and adjust. Never commit .env.
SP_DATABASE_URL=postgresql+asyncpg://standingproof:standingproof@localhost:5432/standingproof
SP_REDIS_URL=redis://localhost:6379/0
SP_ENVIRONMENT=dev

# Model provider. Get a key from https://platform.claude.com/ and keep it out of git.
ANTHROPIC_API_KEY=
SP_DRAFT_MODEL=claude-opus-5-5
SP_DRAFT_EFFORT=medium
# Hard ceilings for one agent run.
SP_RUN_MAX_STEPS=8
SP_RUN_MAX_COST_USD=0.50
SP_RUN_MAX_SECONDS=120

# Ceilings for an uploaded questionnaire.
SP_UPLOAD_MAX_BYTES=5242880
SP_UPLOAD_MAX_UNCOMPRESSED_BYTES=52428800
SP_UPLOAD_MAX_SHEETS=20
SP_UPLOAD_MAX_ROWS_PER_SHEET=100000
SP_UPLOAD_MAX_QUESTIONS=5000
SP_QUESTION_MAX_CHARS=4000

# Embeddings. The default model runs locally: no key, and no text leaves the machine.
SP_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# To try Voyage AI instead: set SP_EMBEDDING_MODEL=voyage-4-lite, put a key here, then run
#   python -m standingproof.library reembed
# Library text is then sent to Voyage. Get a key from https://dash.voyageai.com/
VOYAGE_API_KEY=

# Ceilings for the library.
SP_POLICY_MAX_BYTES=1048576
SP_POLICY_MAX_CHUNKS=500
SP_CHUNK_MAX_CHARS=1200
SP_LIBRARY_TEXT_MAX_CHARS=4000
SP_SEARCH_MAX_RESULTS=20

# Live checks. Both credentials must be read-only; see SECURITY.md for the exact permissions.
# GitHub: a fine-grained token with repository Administration: read and organisation
# Administration: read.
SP_GITHUB_TOKEN=
# The organisations that token may be used on, comma-separated. A scope not listed here
# cannot be connected, whoever asks.
SP_GITHUB_ORGS=
# AWS: the SDK reads its standard variables. The identity needs five read actions.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# The 12-digit account ids those AWS credentials may be used on, comma-separated.
SP_AWS_ACCOUNTS=
SP_AWS_REGION=us-east-1
# A check slower than this is recorded as unavailable. An observation younger than the
# second value is returned again without a new call.
SP_CHECK_TIMEOUT_SECONDS=15
SP_EVIDENCE_MAX_AGE_SECONDS=900

# Running a questionnaire. The worker service does this; the API only queues the work.
# A run stops starting questions once it has spent this much (US dollars).
SP_RUN_COST_LIMIT_USD=5.0
# Questions one worker works on at once.
SP_WORKER_CONCURRENCY=4
# How long a worker may hold a question without renewing. Keep it above SP_RUN_MAX_SECONDS.
SP_LEASE_SECONDS=180
# A question is given up as failed after this many attempts.
SP_QUESTION_MAX_ATTEMPTS=3
# Saved workflow state is deleted this many days after a question finishes.
SP_STATE_KEEP_DAYS=7

# Review. Until sign-in exists, decisions are recorded under this name.
SP_DEV_REVIEWER=dev-reviewer
# How many times a reviewer may send one question back for a redraft.
SP_MAX_REDRAFTS=2
# Web origins whose pages may open the live connection, comma-separated.
SP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# A question nobody decides is closed as expired after this many days.
SP_REVIEW_KEEP_DAYS=30
